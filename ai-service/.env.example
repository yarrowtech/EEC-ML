# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_SUMMARY_MODEL=qwen2.5:14b
OLLAMA_CLEAN_MODEL=llama3.2:3b
OLLAMA_ASSESS_MODEL=qwen3:8b

# Vision extraction (not connected to automatic ingestion yet)
OLLAMA_VISION_MODEL=qwen3.5:9b-q8_0
OLLAMA_VISION_NUM_CTX=16384
OLLAMA_VISION_TIMEOUT=180
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_MAX_PAGES=6
OLLAMA_VISION_MAX_IMAGE_DIMENSION=1600
OLLAMA_VISION_MIN_TEXT_CHARS=80

# Data stores
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=teacher_documents
QDRANT_VECTOR_SIZE=768
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=eec_ai

# Optional production generation provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
