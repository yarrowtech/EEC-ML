MONGODB_URL=mongodb://127.0.0.1:27017/electronic-educare
REDIS_URL=redis://127.0.0.1:6379
# Required when PM2 runs more than one backend worker so Socket.IO rooms and
# chat events are shared across processes.
SOCKET_IO_REDIS_ENABLED=true
SOCKET_IO_REDIS_REQUIRED=true
JWT_SECRET=replace-with-a-long-random-secret
# Shared secret for server-to-server calls the backend makes to itself
# (e.g. exam publish -> mastery re-assessment). Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=replace-with-a-long-random-secret
# Required for first-admin registration in production; send as
# x-super-admin-bootstrap-secret only during the one-time bootstrap.
SUPER_ADMIN_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret
# Set true only for an intentional emergency super-admin password rotation.
RESET_SUPER_ADMIN_PASSWORD=false
# Encrypts student & parent PII at rest (mobile, email, address, Aadhaar…).
# Format: hex:<64-char-hex> or base64:<44-char-base64>. Generate: openssl rand -hex 32
# REQUIRED unless NODE_ENV is exactly "development" or "test" — an unset or
# "production"/"staging" NODE_ENV with no key now throws (it no longer silently
# derives a key from JWT_SECRET). The derived dev fallback never uses the DB URL.
# If you already have data encrypted with the old derived key, run
#   node scripts/reencryptSensitiveData.js --dry-run
# then --apply BEFORE setting this and before rotating JWT_SECRET.
STUDENT_DATA_ENCRYPTION_KEY=replace-with-hex:<64-char-hex>

# ── Domains / proxy ──────────────────────────────────────────────────────────
ROOT_DOMAIN=electroniceducare.com
MAIN_DOMAIN=electroniceducare.com
TRUST_PROXY=loopback
# Development only: allow browser origins on private Wi-Fi address ranges.
# This setting is ignored when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_LAN=true
# Development only: permit school credentials through localhost/LAN IP login.
# Production tenant accounts still require their resolved organization domain.
ALLOW_SHARED_DOMAIN_TENANT_LOGIN=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MS=600000
# Generate with: openssl rand -base64 32
# If unset in development, the backend derives a fallback key from JWT_SECRET.
PAYMENT_ENCRYPTION_KEY=replace-with-a-32-byte-base64-value
RAZORPAY_TIMEOUT_MS=10000
# Optional outside Render. Render provides RENDER_EXTERNAL_URL automatically.
# KEEP_ALIVE_URL=https://your-service.onrender.com/health

# ── AI service (Python FastAPI microservice) ──────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_INTERNAL_KEY in ai-service/.env — sent as X-Internal-Key
# on every backend->ai-service request. Generate with: openssl rand -hex 32
AI_SERVICE_INTERNAL_KEY=replace-with-a-long-random-secret
